{
  "name": "theme.electerm.org",
  "version": "1.0.0",
  "description": "Electerm theme editor and sharing platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/scripts/dev.js",
    "wdev": "wrangler dev --port 26789 --ip 127.0.0.1",
    "build": "node src/scripts/build.js",
    "start": "concurrently -n dev,wdev -c green,blue \"npm run dev\" \"npm run wdev\"",
    "build:pages": "node src/scripts/build-pages.js",
    "build:styles": "node src/scripts/build-styles.js",
    "build:js": "node src/scripts/build-js.js",
    "build:static": "node src/scripts/build-static.js",
    "lint": "standard",
    "fix": "standard --fix",
    "test": "node --test \"test/**/*.test.js\"",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 execute theme-electerm-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute theme-electerm-db --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "nanoid": "^6.0.0"
  },
  "standard": {
    "ignore": [
      "temp/",
      "public/"
    ],
    "envs": [
      "browser"
    ],
    "overrides": [
      {
        "files": [
          "test/**/*.js",
          "src/worker/**/*.js",
          "src/scripts/**/*.js"
        ],
        "envs": [
          "browser",
          "node"
        ]
      }
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "esbuild": "^0.24.0",
    "express": "^4.21.2",
    "pug": "^3.0.3",
    "standard": "^17.1.2",
    "stylus": "^0.64.0",
    "wrangler": "^4.110.0"
  }
}
