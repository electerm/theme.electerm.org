# run `cp .sample.env .env` to create your local env

# GitHub OAuth (required)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://127.0.0.1:5678/api/github-login-callback

# Server secret for JWT signing
SERVER_SECRET=change-this-in-production

# Admin users (comma-separated GitHub handles)
ADMIN_GITHUB_HANDLES=zxdong262

# Token expiry
TOKEN_EXPIRED_TIME=120y

# Dev server
DEV_HOST=127.0.0.1
DEV_PORT=5678
