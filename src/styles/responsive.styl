// === Responsive ===

@media (max-width: 960px)
  .footer-inner
    grid-template-columns: 1fr 1fr

  .editor-body
    flex-direction: column

  .editor-panel
    width: 100%
    min-width: 0
    max-height: 40vh
    flex: none

  .phone-frame
    width: 100%
    max-width: 420px
    height: 700px

@media (max-width: 768px)
  .mobile-menu-toggle
    display: flex

  .main-nav
    position: fixed
    top: var(--header-height)
    left: 0
    right: 0
    bottom: 0
    flex-direction: column
    background: #fff
    padding: 24px
    gap: 16px
    transform: translateX(100%)
    transition: transform var(--transition)
    z-index: 99
    overflow-y: auto

    &.open
      transform: translateX(0)

  .nav-list
    flex-direction: column
    width: 100%
    gap: 8px

  .nav-link
    display: block
    padding: 12px 16px

  .nav-actions
    flex-direction: column
    width: 100%
    align-items: stretch

  .hero-title
    font-size: 2.2rem

  .hero-subtitle
    font-size: 1.05rem

  .footer-inner
    grid-template-columns: 1fr
    gap: 32px

  .user-header
    flex-direction: column
    text-align: center

  .detail-actions
    flex-direction: column
    align-items: stretch

  .share-buttons
    margin-left: 0
    justify-content: center

  .detail-meta
    flex-direction: column
    gap: 12px

  .phone-frame
    height: 600px

  .phone-frame-sm
    width: 100%
    max-width: 360px
    height: 500px

@media (max-width: 480px)
  .hero-title
    font-size: 1.8rem

  .page-title
    font-size: 1.8rem

  .section-title
    font-size: 1.5rem

  .hero-actions
    flex-direction: column
    width: 100%

  .hero-actions .btn
    width: 100%

  .editor-toolbar
    flex-direction: column
    align-items: stretch

  .toolbar-left
    min-width: 0

  .toolbar-right
    justify-content: center

  .phone-frame
    height: 500px
    border-width: 4px

  .phone-frame-sm
    height: 400px

  .themes-grid
    grid-template-columns: 1fr

  .themes-list
    grid-template-columns: 1fr
