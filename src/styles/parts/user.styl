// === User page ===

.user-page
  padding: 48px 24px 48px
  max-width: 1200px
  margin: 0 auto
  width: 100%

.user-header
  display: flex
  align-items: center
  gap: 16px
  margin-bottom: 32px
  flex-wrap: wrap

.user-avatar
  width: 64px
  height: 64px
  border-radius: 50%
  object-fit: cover

.user-info
  flex: 1

  h1
    font-size: 1.5rem
    font-weight: 800
    margin: 0 0 4px

.user-github
  font-size: 0.85rem
  color: var(--text-muted)
  &:hover
    color: var(--brand-600)

.user-stats
  display: flex
  gap: 16px
  font-size: 0.85rem
  color: var(--text-muted)
  margin-top: 4px

.user-actions
  display: flex
  gap: 8px

.user-section
  margin-bottom: 32px

  .section-title
    font-size: 1.2rem
    font-weight: 700
    margin: 0 0 16px

.themes-list
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: 16px

.theme-item
  display: flex
  flex-direction: column
  background: #fff
  border: 1px solid var(--border)
  border-radius: var(--radius-lg)
  overflow: hidden
  cursor: pointer
  transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition)
  &:hover
    transform: translateY(-2px)
    border-color: var(--brand-300)
    box-shadow: var(--shadow-soft)

.theme-item-preview
  height: 80px
  display: flex
  align-items: center
  justify-content: center
  overflow: hidden

.theme-item-colors
  display: flex
  flex-wrap: wrap
  width: 100%
  height: 100%

  .theme-color-swatch
    flex: 1
    min-width: 20px
    height: 100%

.theme-item-info
  padding: 12px 16px
  flex: 1

.theme-item-name
  font-size: 0.95rem
  font-weight: 600
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis
  margin-bottom: 4px

.theme-item-meta
  font-size: 0.8rem
  color: var(--text-muted)
  display: flex
  gap: 8px
  align-items: center

.theme-item-likes
  display: flex
  align-items: center
  gap: 4px

.theme-item-actions
  display: flex
  gap: 4px
  padding: 0 16px 12px
  flex-wrap: wrap

.theme-item-actions .btn
  padding: 4px 10px
  font-size: 0.8rem

.badge-public
  background: rgba(6, 214, 160, .15)
  color: #06D6A0
  padding: 2px 6px
  border-radius: 4px
  font-size: 0.7rem
  font-weight: 600

.badge-private
  background: var(--gray-100)
  color: var(--text-muted)
  padding: 2px 6px
  border-radius: 4px
  font-size: 0.7rem
  font-weight: 600

.empty-state
  text-align: center
  padding: 32px
  color: var(--text-muted)
  font-size: 0.95rem
