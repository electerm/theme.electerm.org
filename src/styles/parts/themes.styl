// === Themes listing page ===

.themes-page
  padding: 0 24px 48px
  max-width: 1400px
  margin: 0 auto
  width: 100%

.page-header
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: 12px
  margin-bottom: 24px

.page-title
  font-size: 2.5rem
  font-weight: 800
  letter-spacing: -0.03em
  margin: 0

.page-stats
  font-size: 0.9rem
  color: var(--text-muted)

.sort-controls
  margin-left: auto
  display: flex
  gap: 4px
  background: var(--gray-50)
  border: 1px solid var(--border)
  border-radius: var(--radius-sm)
  padding: 4px

.sort-btn
  background: transparent
  border: 0
  color: var(--text-muted)
  padding: 6px 12px
  border-radius: 4px
  cursor: pointer
  font-size: 0.85rem
  font-weight: 500
  transition: all var(--transition)
  &:hover
    color: var(--text)
  &.active
    background: #fff
    color: var(--brand-600)
    box-shadow: var(--shadow-sm)

.themes-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: 16px

.theme-card
  background: #fff
  border: 1px solid var(--border)
  border-radius: var(--radius-lg)
  overflow: hidden
  cursor: pointer
  transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition)
  &:hover
    transform: translateY(-2px)
    border-color: var(--brand-300)
    box-shadow: var(--shadow-soft)

.theme-card-preview
  height: 120px
  display: flex
  align-items: center
  justify-content: center
  position: relative
  overflow: hidden

.theme-card-colors
  display: flex
  flex-wrap: wrap
  width: 100%
  height: 100%

.theme-color-swatch
  flex: 1
  min-width: 20px
  height: 100%

.theme-card-info
  padding: 16px

.theme-card-name
  font-size: 1rem
  font-weight: 600
  margin: 0 0 6px
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.theme-card-meta
  display: flex
  align-items: center
  justify-content: space-between
  gap: 8px
  font-size: 0.85rem
  color: var(--text-muted)

.theme-card-author
  display: flex
  align-items: center
  gap: 6px
  min-width: 0

.theme-card-author-avatar
  width: 18px
  height: 18px
  border-radius: 50%
  flex-shrink: 0
  background: var(--gray-100)

.theme-card-author-name
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.theme-card-likes
  display: flex
  align-items: center
  gap: 4px
  flex-shrink: 0

.load-more-wrap
  text-align: center
  margin-top: 24px

.empty-state
  text-align: center
  padding: 32px
  color: var(--text-muted)
  font-size: 0.95rem
