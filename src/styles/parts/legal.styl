// === Legal pages (privacy, terms of use) ===

.legal-page
  padding: 64px 0 96px

.legal-container
  max-width: 760px

.legal-title
  font-size: 2.25rem
  font-weight: 800
  color: var(--gray-900)
  margin-bottom: 8px

.legal-updated
  font-size: 0.85rem
  color: var(--gray-500)
  margin-bottom: 24px

.legal-intro
  font-size: 1.05rem
  line-height: 1.7
  color: var(--gray-700)
  padding: 20px 24px
  background: var(--gray-50)
  border-left: 3px solid var(--primary, #08c)
  border-radius: 0 8px 8px 0
  margin-bottom: 40px

.legal-section
  margin-bottom: 40px

.legal-section-title
  font-size: 1.25rem
  font-weight: 700
  color: var(--gray-900)
  margin-bottom: 16px

.legal-section-body
  font-size: 0.98rem
  line-height: 1.75
  color: var(--gray-700)
  margin-bottom: 14px

.legal-back
  margin-top: 48px
  text-align: center
