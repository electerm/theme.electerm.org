// === Login & 404 pages ===

.login-page
  display: flex
  align-items: center
  justify-content: center
  flex: 1
  padding: 48px 24px

.login-card
  text-align: center
  max-width: 400px

.login-title
  font-size: 1.5rem
  font-weight: 800
  letter-spacing: -0.02em
  margin: 0 0 8px

.login-subtitle
  font-size: 0.95rem
  color: var(--text-muted)
  margin: 0 0 32px

.btn-github
  display: inline-flex
  align-items: center
  gap: 10px
  background: var(--gray-900)
  color: #fff
  padding: 12px 32px
  border: 0
  border-radius: var(--radius)
  font-size: 1rem
  font-weight: 600
  cursor: pointer
  transition: background var(--transition)
  &:hover
    background: var(--gray-800)
    color: #fff

.github-icon
  flex-shrink: 0

.login-terms
  margin-top: 18px
  font-size: 0.85rem
  color: var(--text-muted)
  line-height: 1.6

.login-terms-link
  color: var(--primary, #08c)
  text-decoration: underline
  text-underline-offset: 2px
  &:hover
    text-decoration: none

.login-note
  margin-top: 24px
  font-size: 0.85rem
  color: var(--text-muted)
  p
    margin: 4px 0

// 404 page
.not-found-page
  display: flex
  align-items: center
  justify-content: center
  flex: 1

.not-found-content
  text-align: center

.not-found-code
  font-size: 72px
  font-weight: 800
  color: var(--text-muted)
  margin: 0

.not-found-message
  font-size: 1rem
  color: var(--text-muted)
  margin: 16px 0 24px
