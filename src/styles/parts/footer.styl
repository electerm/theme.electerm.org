// === Footer ===

.site-footer
  background: var(--gray-900)
  color: var(--gray-300)
  padding: 56px 0 24px
  margin-top: auto

.footer-inner
  display: grid
  grid-template-columns: 2fr 1fr 1fr 1fr
  gap: 40px
  padding-bottom: 40px

.footer-brand
  max-width: 320px

.footer-logo
  height: 32px
  width: auto
  filter: brightness(0) invert(1)
  margin-bottom: 16px

.footer-desc
  font-size: 0.9rem
  line-height: 1.6
  color: var(--gray-400)
  margin-bottom: 12px

.footer-heading
  font-size: 0.85rem
  font-weight: 600
  color: #fff
  text-transform: uppercase
  letter-spacing: 0.05em
  margin-bottom: 16px

.footer-links
  li
    margin-bottom: 10px

.footer-links a
  font-size: 0.9rem
  color: var(--gray-400)
  transition: color var(--transition)

  &:hover
    color: #fff

.footer-bottom
  border-top: 1px solid var(--gray-800)
  padding-top: 24px
  text-align: center

  p
    font-size: 0.85rem
    color: var(--gray-500)
