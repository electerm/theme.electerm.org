// === Editor (home page) ===

.editor-page
  display: flex
  flex-direction: column
  padding: 0 24px 48px
  max-width: var(--container-wide)
  margin: 0 auto
  width: 100%

.editor-toolbar
  display: flex
  align-items: center
  justify-content: space-between
  padding: 0 0 12px
  gap: 12px
  flex-wrap: wrap

.toolbar-left
  flex: 1
  min-width: 200px

.toolbar-right
  display: flex
  gap: 8px
  flex-wrap: wrap

.theme-name-input
  background: transparent
  border: 0
  border-bottom: 1px solid var(--border)
  color: var(--text)
  padding: 8px 0
  border-radius: 0
  font-size: 14px
  width: 100%
  max-width: 300px
  &:focus
    outline: none
    border-bottom-color: var(--brand-600)

.editor-body
  flex: 1
  display: flex
  min-height: 0
  gap: 16px

.editor-panel
  flex: 1
  min-width: 320px
  display: flex
  flex-direction: column

.editor-tabs
  display: flex
  border-bottom: 1px solid var(--border)

.tab-btn
  flex: 1
  background: transparent
  border: 0
  border-bottom: 2px solid transparent
  color: var(--text-muted)
  padding: 10px
  cursor: pointer
  font-size: 13px
  font-weight: 500
  transition: all .15s
  &:hover
    color: var(--text)
  &.active
    color: var(--text)
    border-bottom-color: var(--brand-600)

.tab-content
  flex: 1
  overflow-y: auto
  padding: 12px 0

.color-groups
  display: flex
  flex-direction: column
  gap: 20px

.color-group
  .group-title
    font-size: 13px
    font-weight: 600
    color: var(--text-muted)
    margin: 0 0 8px
    text-transform: uppercase
    letter-spacing: .5px

.color-list
  display: grid
  grid-template-columns: 1fr 1fr
  gap: 8px

.color-item
  display: flex
  align-items: center
  gap: 8px
  padding: 6px 8px
  background: var(--gray-50)
  border-radius: var(--radius-sm)
  border: 1px solid var(--border)

.color-item-label
  font-size: 11px
  color: var(--text-muted)
  flex: 1
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.color-picker-wrap
  position: relative
  width: 28px
  height: 28px

.color-picker-input
  width: 28px
  height: 28px
  border: 1px solid var(--border)
  border-radius: var(--radius-sm)
  cursor: pointer
  background: none
  padding: 0
  &::-webkit-color-swatch-wrapper
    padding: 0
  &::-webkit-color-swatch
    border: none
    border-radius: 4px

.theme-textarea
  width: 100%
  height: 100%
  min-height: 400px
  background: var(--gray-50)
  border: 1px solid var(--border)
  color: var(--text)
  padding: 12px
  border-radius: var(--radius-sm)
  font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace
  font-size: 12px
  line-height: 1.6
  resize: none
  &:focus
    outline: none
    border-color: var(--brand-600)

// Preview panel with phone frame
.preview-panel
  flex: 1
  display: flex
  flex-direction: column
  min-width: 0

.preview-frame-wrap
  flex: 1
  min-height: 0
  display: flex
  align-items: center
  justify-content: center
  padding: 32px 24px
  overflow: auto

.preview-footer
  text-align: center
  padding: 4px 0 0

.preview-status
  font-size: 12px
  color: var(--text-muted)
  &.ready
    color: #06D6A0
  &.error
    color: var(--brand-600)

// Phone frame — 420 × 800
.phone-frame
  width: 420px
  height: 800px
  max-height: 100%
  border: 8px solid var(--gray-900)
  border-radius: 32px
  overflow: hidden
  box-shadow: 0 24px 64px -12px rgba(16, 24, 40, 0.22), 0 8px 24px -8px rgba(16, 24, 40, 0.12)
  position: relative
  background: #000
  flex-shrink: 0

  iframe
    width: 100%
    height: 100%
    border: 0
    display: block

// Smaller phone frame for theme detail page
.phone-frame-sm
  width: 360px
  height: 640px
  border-width: 6px
  border-radius: 24px

// === AI theme generator tab ===
.ai-tab
  display: flex
  flex-direction: column
  gap: 12px
  padding: 12px 0

.ai-tab-desc
  margin: 0
  font-size: 0.9rem
  color: var(--text-muted)
  line-height: 1.5

.ai-tab-textarea
  width: 100%
  background: var(--gray-50)
  border: 1px solid var(--border)
  color: var(--text)
  padding: 12px
  border-radius: var(--radius-sm)
  font-size: 14px
  line-height: 1.5
  resize: vertical
  font-family: inherit
  &:focus
    outline: none
    border-color: var(--brand-600)

.ai-tab-actions
  display: flex
  gap: 8px

.ai-tab-hint
  margin: 0
  font-size: 0.8rem
  color: var(--text-muted)
