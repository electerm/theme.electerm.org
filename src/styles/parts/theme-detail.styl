// === Theme detail page ===

.theme-detail-page
  padding: 48px 24px 48px
  max-width: 1200px
  margin: 0 auto
  width: 100%

.detail-header
  margin-bottom: 32px

  h1
    font-size: 2rem
    font-weight: 800
    letter-spacing: -0.02em
    margin: 0 0 20px

.detail-meta
  display: flex
  align-items: center
  gap: 24px
  flex-wrap: wrap
  margin-bottom: 24px

.detail-owner
  display: flex
  align-items: center
  gap: 8px

.owner-avatar
  width: 32px
  height: 32px
  border-radius: 50%

.detail-stats
  display: flex
  gap: 16px
  font-size: 0.9rem
  color: var(--text-muted)

.detail-stat
  display: flex
  align-items: center
  gap: 4px

.stat-icon
  font-size: 1rem

.detail-actions
  display: flex
  gap: 8px
  flex-wrap: wrap
  align-items: center

.share-buttons
  display: flex
  gap: 4px
  margin-left: 8px

.config-text
  background: var(--gray-50)
  border: 1px solid var(--border)
  border-radius: var(--radius)
  padding: 16px
  font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace
  font-size: 12px
  line-height: 1.6
  overflow-x: auto
  white-space: pre-wrap
  word-break: break-all

.detail-preview
  margin-bottom: 24px

  .preview-header
    display: flex
    align-items: center
    padding: 0 4px 8px

  .preview-frame-wrap
    height: 700px
    display: flex
    align-items: center
    justify-content: center
    padding: 24px

.detail-config
  h3
    font-size: 1.1rem
    font-weight: 700
    margin: 0 0 12px
