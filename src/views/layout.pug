doctype html
html(lang=htmlLang)
  head
    include parts/head.pug
  body(data-demo-url=demoUrl data-is-dev=isDev ? 'true' : 'false')
    include parts/header.pug
    main#main.main
      block content
    .toast#toast
    include parts/footer.pug
    //- Embed all locale i18n data for client-side language switching
    script(type="application/json" id="page-i18n-data") !{i18nData}
    if jsPath
      script(type="module" src=jsPath)
    block scripts

    //- Google Analytics 4 (gtag.js) — production only, skip dev/local traffic
    if isProd && site.gaId
      script(async src=`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`)
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', !{JSON.stringify(site.gaId)});
