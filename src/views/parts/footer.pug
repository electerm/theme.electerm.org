include ads

footer.site-footer
  .container.footer-inner
    .footer-brand
      a.brand(href=homePath)
        img.footer-logo(src="https://electerm.org/electerm.png" alt=site.name width="120" height="42")
      p.footer-desc(data-i18n="footer.description")= footer.description

    .footer-links-group
      h4.footer-heading(data-i18n="footer.productLinks")= footer.productLinks
      ul.footer-links
        each link, i in footer.links.product
          - const isExt = /^https?:/i.test(link.href)
          li
            a(href=link.href target=isExt ? '_blank' : false rel=isExt ? 'noopener noreferrer' : false data-i18n=`footer.links.product.${i}.label`)= link.label

    .footer-links-group
      h4.footer-heading(data-i18n="footer.projectLinks")= footer.projectLinks
      ul.footer-links
        each link, i in footer.links.project
          - const isExt = /^https?:/i.test(link.href)
          li
            a(href=link.href target=isExt ? '_blank' : false rel=isExt ? 'noopener noreferrer' : false data-i18n=`footer.links.project.${i}.label`)= link.label

    .footer-links-group
      h4.footer-heading(data-i18n="footer.legalLinks")= footer.legalLinks
      ul.footer-links
        each link, i in footer.links.legal
          - const isExt = /^https?:/i.test(link.href)
          li
            a(href=link.href target=isExt ? '_blank' : false rel=isExt ? 'noopener noreferrer' : false data-i18n=`footer.links.legal.${i}.label`)= link.label

  .container.footer-bottom
    p
      | &copy; #{year} #{site.name}.
      span(data-i18n="footer.copyright")= footer.copyright

script.
  (function(){
    // === Ad loading — Carbon Ads or EthicalAds, whichever wrapper is present ===
    var wrapper = document.querySelector('.ethical-ad-wrapper, .carbon-ad-wrapper');
    if (!wrapper) return;

    var isCarbon = wrapper.classList.contains('carbon-ad-wrapper');

    if (isCarbon) {
      // === Carbon Ads — inject carbon.js into the container and reveal it ===
      wrapper.classList.add('carbon-ad-active');
      var cs = document.createElement('script');
      cs.async = true;
      cs.type = 'text/javascript';
      // serve/placement are Carbon Ads IDs; update for this domain as needed.
      cs.src = '//cdn.carbonads.com/carbon.js?serve=CWBDE2JL&placement=electermorg&format=responsive';
      cs.id = '_carbonads_js';
      wrapper.appendChild(cs);
    } else {
      // === EthicalAds — load and show ===
      var adUnit = wrapper.querySelector('.ethical-ad-unit');
      if (!adUnit) return;

      var BP_MOBILE = 480;
      var BP_WIDE = 1420;
      var currentMode = null;

      // Three ad modes:
      //  'v-image'  → >= 1420px: vertical image ad (corner card)
      //  'h-image'  → 480px-1419px: horizontal image ad (bottom bar)
      //  'text'     → < 480px: text ad (bottom bar)
      function getMode(vw) {
        if (vw < BP_MOBILE) return 'text';
        if (vw < BP_WIDE) return 'h-image';
        return 'v-image';
      }

      function updateAd() {
        var vw = window.innerWidth || document.documentElement.clientWidth;
        var mode = getMode(vw);

        var newType = (mode === 'text') ? 'text' : 'image';
        var oldType = adUnit.getAttribute('data-ea-type');

        if (mode === 'h-image') {
          adUnit.classList.add('horizontal');
        } else {
          adUnit.classList.remove('horizontal');
        }

        if (mode !== currentMode) {
          currentMode = mode;
          if (newType !== oldType) {
            adUnit.setAttribute('data-ea-type', newType);
          }
          if (window.ethicalads && window.ethicalads.reload) {
            window.ethicalads.reload();
          }
        }
      }

      // Show the ad container and load EthicalAds script.
      wrapper.classList.add('ethical-ad-active');
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://media.ethicalads.io/media/client/ethicalads.min.js';
      document.body.appendChild(s);

      // Set initial mode before EthicalAds loads.
      var initVw = window.innerWidth || document.documentElement.clientWidth;
      var initMode = getMode(initVw);
      currentMode = initMode;
      if (initMode === 'text') {
        adUnit.setAttribute('data-ea-type', 'text');
      } else if (initMode === 'h-image') {
        adUnit.classList.add('horizontal');
      }

      // Re-evaluate on resize (debounced)
      var adRt = null;
      window.addEventListener('resize', function(){
        if (adRt) clearTimeout(adRt);
        adRt = setTimeout(updateAd, 150);
      });
    }

    // === Ad spacing: keep the fixed ad bar/card (EthicalAds or Carbon Ads) from covering footer content ===
    var footer = document.querySelector('footer.site-footer');
    var BP = 1420;
    function apply() {
      var h = wrapper.offsetHeight || 0;
      var vw = window.innerWidth || document.documentElement.clientWidth;
      if (vw < BP) {
        // < 1420px: full-width fixed bar pinned to viewport bottom.
        // Reserve space on <body> so the bar never hides the footer.
        document.body.style.paddingBottom = h + 'px';
        if (footer) {
          footer.style.paddingBottom = '';
        }
      } else {
        // >= 1420px: corner card fixed 24px above the viewport bottom-right.
        // Reserve space inside the footer.
        document.body.style.paddingBottom = '';
        if (footer) {
          if (h > 0) {
            footer.style.paddingBottom = (h + 32) + 'px';
          } else {
            footer.style.paddingBottom = '';
          }
        }
      }
    }
    if (window.ResizeObserver) {
      new ResizeObserver(function(){ apply(); }).observe(wrapper);
    }
    var rt = null;
    window.addEventListener('resize', function(){
      if (rt) clearTimeout(rt);
      rt = setTimeout(apply, 100);
    });
    apply();
    // ad networks load async; re-measure once creatives likely rendered
    setTimeout(apply, 1500);
    setTimeout(apply, 3000);
  })();
